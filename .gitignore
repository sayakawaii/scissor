# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# local config & secrets (never commit api keys)
.env
.env.*
config.json
*.local.json

# eval run scratch (machine-specific timings, raw per-task detail)
evals/
# NOTE: benchmarks/ is deliberately NOT ignored — published comparison artifacts
# are committed so results are reviewable and reproducible. `scissor benchmark`
# writes only aggregates plus provenance there (no paths, hosts, users, keys).

# MCP config (may contain env/secrets) and saved tool images
mcp.json
.scissor/

# logs
*.log
npm-debug.log*

# editor / os
.DS_Store
Thumbs.db
.vscode/
.idea/
